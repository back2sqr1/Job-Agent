# Copy this file to `.env` (in the repo root) to set environment variables
# without exporting them in your shell. `.env` is gitignored, so anything
# here stays on your machine. Real shell environment variables still win
# over values in this file.

# Optional: enables the LLM field-mapping assist in the generic autofill
# sweep (see src/ats/autofill.ts). Requires an Anthropic API account —
# billed per use to this key. Only form field labels are sent to the API,
# never your profile data. Without it, the built-in heuristics still run.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: port for `npm start` (defaults to 3000).
# PORT=3000
